   "source": [
    "from PIL import Image\n",
    "import cv2\n",
    "\n",
    "ref = cv2.imread('1.jpeg', cv2.IMREAD_GRAYSCALE)\n",
    "ret, thresh = cv2.threshold(ref, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n",
    "mask = Image.fromarray(thresh)\n",
    "mask.save('1_mask.png')\n",
    "mask"
   ],
